{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cli-output.schema.json",
  "title": "dspm local CLI output (Spec 2.4)",
  "description": "Validates an individual query response, mutation NDJSON record, or root version response. NDJSON validation applies separately to each record. Event ordering, completion, and cross-field constraints are specified in ../interoperability.md. Additional properties support additive extensions. Additional event types require an updated schema.",
  "oneOf": [
    { "$ref": "#/$defs/querySuccess" },
    { "$ref": "#/$defs/queryFailure" },
    { "$ref": "#/$defs/mutationEvent" },
    { "$ref": "#/$defs/versionResponse" }
  ],
  "$defs": {
    "packageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$"
    },
    "genericId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "dottedId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "description": "The value contains four arbitrary-precision decimal integer components. Version comparison requires numeric component comparison. Package and manifest versions use this representation independently of the executable version."
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$",
      "description": "The value is the lowercase SHA-512 content tree digest derived from package file paths and contents."
    },
    "directory": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "The value is lowercase hexadecimal SHA-256 of UTF-8(id + '=' + normalized version). It names an immediate child of the package root."
    },
    "text": {
      "type": "object",
      "required": ["_"],
      "additionalProperties": { "type": "string" },
      "description": "The object retains all language keys and explicit empty strings. The key '_' identifies the default value."
    },
    "filePaths": {
      "$ref": "#/$defs/text",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "description": "Each localized value is a nonempty, fully qualified, lexically normalized host path in the package read context. Each reference must identify a regular file inside the package."
    },
    "diagnosticArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "diagnostics": {
      "description": "Envelope diagnostics and packing summary diagnostics can be null or a string array, including an empty array.",
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/diagnosticArray" }
      ]
    },
    "stringArrayOrNull": {
      "anyOf": [
        { "type": "null" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "identity": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/packageId" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "dependency": {
      "$ref": "#/$defs/identity",
      "description": "The object identifies a declared dependency target. It does not identify the resolved compatible provider version."
    },
    "contributionSummary": {
      "type": "object",
      "description": "The object represents an indexed contribution. Singer summaries can include extracted declaration fields and names. Opaque summaries contain category and ID only.",
      "required": ["category", "id"],
      "properties": {
        "category": { "$ref": "#/$defs/dottedId" },
        "id": { "$ref": "#/$defs/genericId" },
        "interface": { "$ref": "#/$defs/dottedId" },
        "level": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "variant": { "$ref": "#/$defs/dottedId" },
        "name": { "$ref": "#/$defs/text" }
      },
      "if": { "properties": { "category": { "const": "singer" } } },
      "else": {
        "not": { "anyOf": [
          { "required": ["name"] }, { "required": ["interface"] },
          { "required": ["level"] }, { "required": ["variant"] }
        ] }
      }
    },
    "installedPackage": {
      "type": "object",
      "required": ["id", "version", "compatVersion", "hash", "installedAt", "directory", "dependencies", "contributions"],
      "properties": {
        "id": { "$ref": "#/$defs/packageId" },
        "version": { "$ref": "#/$defs/version" },
        "compatVersion": { "$ref": "#/$defs/version" },
        "hash": { "$ref": "#/$defs/hash" },
        "installedAt": { "type": "integer", "description": "The value is the installation Unix timestamp in seconds." },
        "directory": { "$ref": "#/$defs/directory" },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "name": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "vendor": { "$ref": "#/$defs/text" },
        "contributions": { "type": "array", "items": { "$ref": "#/$defs/contributionSummary" } }
      }
    },
    "singer": {
      "type": "object",
      "properties": {
        "avatar": { "$ref": "#/$defs/text" },
        "background": { "$ref": "#/$defs/text" },
        "demoAudio": { "$ref": "#/$defs/text" }
      },
      "description": "The object contains extracted singer resource strings and can be empty. Resource paths, media formats, and referenced files are not validated."
    },
    "contribution": {
      "type": "object",
      "required": ["category", "id", "entry"],
      "properties": {
        "category": { "$ref": "#/$defs/dottedId" },
        "id": { "$ref": "#/$defs/genericId" },
        "path": { "type": "string", "minLength": 1 },
        "entry": { "type": "object", "description": "The object retains the expanded desc.json contribution entry and arbitrary fields. A non-string path in an opaque entry remains uninterpreted category data." },
        "manifest": { "type": "object", "description": "The object contains the singer declaration. The expanded flag distinguishes expanded metadata from a raw declaration retained after expansion failure. The field is absent for opaque contributions." },
        "expanded": { "type": "boolean", "description": "The value indicates successful singer declaration expansion. The field is absent for opaque contributions." },
        "name": { "$ref": "#/$defs/text", "description": "The object contains the extracted singer name or the contribution ID if no name is declared. The field is absent for opaque contributions." },
        "interface": { "$ref": "#/$defs/dottedId", "description": "The value is an interface ID extracted from singer metadata." },
        "level": { "type": "integer", "minimum": 1, "description": "The value is a positive arbitrary-precision integer extracted from singer metadata." },
        "variant": { "$ref": "#/$defs/dottedId", "description": "The value is a variant ID extracted from singer metadata." },
        "singer": { "$ref": "#/$defs/singer" }
      },
      "if": { "properties": { "category": { "const": "singer" } } },
      "then": { "required": ["manifest", "expanded"] },
      "else": {
        "not": { "anyOf": [
          { "required": ["name"] }, { "required": ["interface"] },
          { "required": ["level"] }, { "required": ["variant"] },
          { "required": ["manifest"] }, { "required": ["expanded"] },
          { "required": ["singer"] }
        ] }
      }
    },
    "packageManifest": {
      "type": "object",
      "required": ["id", "version", "formatVersion", "runtimeLevel", "compatVersion", "dependencies", "contributions", "manifest"],
      "properties": {
        "id": { "$ref": "#/$defs/packageId" },
        "version": { "$ref": "#/$defs/version" },
        "formatVersion": { "const": "1.0.0.0" },
        "runtimeLevel": { "const": 1 },
        "compatVersion": { "$ref": "#/$defs/version" },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "contributions": { "type": "array", "items": { "$ref": "#/$defs/contribution" } },
        "name": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "vendor": { "$ref": "#/$defs/text" },
        "license": { "$ref": "#/$defs/filePaths" },
        "readme": { "$ref": "#/$defs/filePaths" },
        "url": { "type": "string", "description": "The value is the website string after variable expansion. An explicit empty string is retained. The field is omitted if absent." },
        "manifest": { "type": "object", "description": "The object contains expanded desc.json with vars removed. Arbitrary package fields and JSON types are retained. Source formatting and comments are excluded." },
        "diagnostics": { "$ref": "#/$defs/diagnosticArray" }
      }
    },
    "info": {
      "type": "object",
      "required": ["package"],
      "properties": {
        "package": { "$ref": "#/$defs/packageManifest" },
        "installation": { "$ref": "#/$defs/installedPackage" },
        "file": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/hash" }
      },
      "oneOf": [
        { "required": ["file", "hash"], "not": { "required": ["installation"] } },
        { "required": ["installation"], "not": { "anyOf": [{ "required": ["file"] }, { "required": ["hash"] }] } }
      ]
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "details": {}
      },
      "description": "Defined codes are INVALID_ARGUMENT, INVALID_PACKAGE, CONFLICT, DEPENDENCY_ERROR, NOT_FOUND, AMBIGUOUS_VERSION, CANCELLED, and IO_ERROR. Unknown codes require generic failure handling. AMBIGUOUS_VERSION details contains an array of canonical package selectors."
    },
    "querySuccess": {
      "type": "object",
      "required": ["ok", "command", "data", "diagnostics"],
      "properties": {
        "ok": { "const": true },
        "diagnostics": { "$ref": "#/$defs/diagnostics" }
      },
      "not": { "anyOf": [{ "required": ["error"] }, { "required": ["event"] }] },
      "oneOf": [
        { "properties": { "command": { "const": "info" }, "data": { "$ref": "#/$defs/info" } } },
        { "properties": { "command": { "const": "list" }, "data": { "type": "array", "items": { "$ref": "#/$defs/installedPackage" } } } }
      ]
    },
    "queryFailure": {
      "type": "object",
      "required": ["ok", "command", "error", "diagnostics"],
      "properties": {
        "ok": { "const": false },
        "command": { "type": "string", "minLength": 1 },
        "error": { "$ref": "#/$defs/error" },
        "diagnostics": { "$ref": "#/$defs/diagnostics" }
      },
      "not": { "anyOf": [{ "required": ["data"] }, { "required": ["event"] }] },
      "description": "Argument and command setup errors can identify the root command dspm or the selected subcommand."
    },
    "action": {
      "type": "object",
      "required": ["package", "action"],
      "properties": {
        "package": { "$ref": "#/$defs/identity" },
        "action": { "enum": ["install", "overwrite", "skip", "remove", "cascade"] },
        "file": { "type": "string" },
        "hash": { "$ref": "#/$defs/hash" }
      },
      "if": { "properties": { "action": { "enum": ["install", "overwrite", "skip"] } } },
      "then": { "required": ["file", "hash"] },
      "else": { "not": { "anyOf": [{ "required": ["file"] }, { "required": ["hash"] }] } }
    },
    "installAction": {
      "allOf": [
        { "$ref": "#/$defs/action" },
        { "required": ["file", "hash"], "properties": { "action": { "enum": ["install", "overwrite", "skip"] } } }
      ]
    },
    "removeAction": {
      "allOf": [
        { "$ref": "#/$defs/action" },
        { "properties": { "action": { "enum": ["remove", "cascade"] } }, "not": { "anyOf": [{ "required": ["file"] }, { "required": ["hash"] }] } }
      ]
    },
    "mutationSummary": {
      "type": "object",
      "required": ["actions", "dryRun"],
      "properties": {
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "dryRun": { "type": "boolean" },
        "diagnostics": { "$ref": "#/$defs/diagnosticArray", "minItems": 1 },
        "ignored": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "packPlan": {
      "type": "object",
      "required": ["source", "output", "files", "directories", "bytes", "package"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 },
        "files": { "$ref": "#/$defs/stringArrayOrNull" },
        "directories": { "$ref": "#/$defs/stringArrayOrNull" },
        "bytes": { "type": "integer", "minimum": 0 },
        "package": { "$ref": "#/$defs/packageManifest" }
      }
    },
    "packResult": {
      "type": "object",
      "required": ["file", "hash", "package", "size"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/hash" },
        "size": { "type": "integer", "minimum": 0 },
        "package": { "$ref": "#/$defs/identity" }
      }
    },
    "packSummary": {
      "type": "object",
      "required": ["diagnostics"],
      "properties": {
        "diagnostics": { "$ref": "#/$defs/diagnostics" },
        "dryRun": { "const": true }
      },
      "description": "The dryRun field is present and true for a packing dry run. Normal packing summaries omit dryRun."
    },
    "progress": {
      "type": "object",
      "required": ["phase", "target", "state", "filePath", "current", "total", "filesDone", "filesTotal"],
      "properties": {
        "phase": { "enum": ["inspect", "resolve", "extract", "verify", "commit", "check", "pack"] },
        "target": { "type": "string" },
        "state": { "enum": ["start", "update", "done"] },
        "filePath": { "type": "string" },
        "current": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "filesDone": { "type": "integer", "minimum": 0 },
        "filesTotal": { "type": "integer", "minimum": 0 }
      }
    },
    "mutationRecord": {
      "type": "object",
      "required": ["command", "event", "data"],
      "not": { "anyOf": [{ "required": ["ok"] }, { "required": ["error"] }] }
    },
    "mutationEvent": {
      "oneOf": [
        {
          "allOf": [{ "$ref": "#/$defs/mutationRecord" }],
          "properties": {
            "command": { "enum": ["install", "remove", "pack"] }, "event": { "const": "progress" },
            "data": { "$ref": "#/$defs/progress" }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/mutationRecord" }],
          "properties": {
            "command": { "const": "remove" }, "event": { "const": "ignored" },
            "data": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/mutationRecord" }],
          "properties": {
            "command": { "const": "install" }, "event": { "const": "inspect_start" },
            "data": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/mutationRecord" }],
          "properties": {
            "command": { "const": "install" }, "event": { "enum": ["inspect_ok", "staged"] },
            "data": { "$ref": "#/$defs/identity" }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/mutationRecord" }],
          "properties": {
            "command": { "const": "install" }, "event": { "const": "plan" },
            "data": { "type": "array", "items": { "$ref": "#/$defs/installAction" } }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/mutationRecord" }],
          "properties": {
            "command": { "const": "remove" }, "event": { "const": "plan" },
            "data": { "type": "array", "items": { "$ref": "#/$defs/removeAction" } }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/mutationRecord" }],
          "properties": {
            "command": { "const": "install" }, "event": { "const": "result" },
            "data": { "$ref": "#/$defs/installAction" }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/mutationRecord" }],
          "properties": {
            "command": { "const": "remove" }, "event": { "const": "result" },
            "data": { "$ref": "#/$defs/removeAction" }
          }
        },
        {
          "allOf": [
            { "$ref": "#/$defs/mutationRecord" },
            {
              "if": { "properties": { "command": { "const": "install" } } },
              "then": { "properties": { "data": {
                "properties": { "actions": { "items": { "$ref": "#/$defs/installAction" } } },
                "not": { "required": ["ignored"] }
              } } },
              "else": { "properties": { "data": {
                "properties": { "actions": { "items": { "$ref": "#/$defs/removeAction" } } }
              } } }
            }
          ],
          "properties": {
            "command": { "enum": ["install", "remove"] }, "event": { "const": "summary" },
            "data": { "$ref": "#/$defs/mutationSummary" }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/mutationRecord" }],
          "properties": {
            "command": { "const": "pack" }, "event": { "const": "plan" },
            "data": { "$ref": "#/$defs/packPlan" }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/mutationRecord" }],
          "properties": {
            "command": { "const": "pack" }, "event": { "const": "result" },
            "data": { "$ref": "#/$defs/packResult" }
          }
        },
        {
          "allOf": [{ "$ref": "#/$defs/mutationRecord" }],
          "properties": {
            "command": { "const": "pack" }, "event": { "const": "summary" },
            "data": { "$ref": "#/$defs/packSummary" }
          }
        },
        {
          "type": "object",
          "required": ["command", "event", "error", "diagnostics"],
          "not": { "anyOf": [{ "required": ["ok"] }, { "required": ["data"] }] },
          "properties": {
            "command": { "enum": ["install", "remove", "pack"] }, "event": { "const": "error" },
            "error": { "$ref": "#/$defs/error" }, "diagnostics": { "$ref": "#/$defs/diagnostics" }
          }
        }
      ]
    },
    "versionResponse": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "dspm" },
        "version": { "type": "string" }
      }
    }
  }
}
